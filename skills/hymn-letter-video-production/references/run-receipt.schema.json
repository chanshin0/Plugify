{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugify.local/schemas/hymn-letter-run-receipt.json",
  "title": "Portable Hymn Letter wrapper run receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "stage",
    "release_sha256",
    "job_sha256",
    "source_bundle_sha256",
    "wrapper_path",
    "wrapper_sha256",
    "office_root",
    "office_script_path",
    "office_script_sha256",
    "runtime_python",
    "normalized_command",
    "run_root",
    "delegate_stdout_sha256",
    "delegate_payload",
    "gate"
  ],
  "properties": {
    "schema": {
      "const": "plugify.hymn-letter.run-receipt/1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "render",
        "qc"
      ]
    },
    "release_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "job_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_bundle_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "wrapper_path": {
      "type": "string",
      "minLength": 1
    },
    "wrapper_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "office_root": {
      "type": "string",
      "minLength": 1
    },
    "office_script_path": {
      "type": "string",
      "minLength": 1
    },
    "office_script_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "normalized_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "run_root": {
      "type": "string",
      "minLength": 1
    },
    "delegate_stdout_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delegate_payload": {
      "type": "object"
    },
    "gate": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "semantic-equivalent",
        "reference-bit-exact",
        null
      ]
    }
  }
}
