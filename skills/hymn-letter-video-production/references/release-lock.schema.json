{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugify.local/schemas/hymn-letter-release-lock.json",
  "title": "Office-native Hymn Letter release lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "created_at",
    "source_bundle_lock",
    "environment_lock",
    "golden_lock",
    "jobs",
    "renderer_modules",
    "supported_profiles",
    "notes",
    "source_bundle_lock_sha256",
    "environment_lock_sha256",
    "golden_lock_sha256"
  ],
  "properties": {
    "schema": {
      "const": "godowon.hymn-letter.v3-release-lock/1"
    },
    "release_id": {
      "const": "hymn-letter-caption-v3-gapless-aac-20260824"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_bundle_lock": {
      "type": "string",
      "pattern": "^[^\\\\]+\\.json$"
    },
    "environment_lock": {
      "type": "string",
      "pattern": "^[^\\\\]+\\.json$"
    },
    "golden_lock": {
      "type": "string",
      "pattern": "^[^\\\\]+\\.json$"
    },
    "jobs": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "jobs/01_start.json"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "jobs/02_playlist.json"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "jobs/03_491_testimony.json"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "jobs/04_491_hymn.json"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "jobs/05_370_testimony.json"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
        {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"const": "jobs/06_370_hymn.json"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
      ],
      "items": false
    },
    "renderer_modules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aac_common",
        "caption",
        "profiles",
        "mp4",
        "package",
        "qc",
        "playlist_active_rows",
        "avfoundation_probe_source"
      ],
      "properties": {
        "aac_common": {"allOf": [{"$ref": "#/$defs/module"}, {"properties": {"path": {"const": "godo-hymns/tools/hymn_letter_v3_aac_common.py"}}}]},
        "caption": {"allOf": [{"$ref": "#/$defs/module"}, {"properties": {"path": {"const": "godo-hymns/tools/hymn_letter_caption_v3.py"}}}]},
        "profiles": {"allOf": [{"$ref": "#/$defs/module"}, {"properties": {"path": {"const": "godo-hymns/tools/hymn_letter_v3_profiles_aac.py"}}}]},
        "mp4": {"allOf": [{"$ref": "#/$defs/module"}, {"properties": {"path": {"const": "godo-hymns/tools/hymn_letter_v3_mp4_aac.py"}}}]},
        "package": {"allOf": [{"$ref": "#/$defs/module"}, {"properties": {"path": {"const": "godo-hymns/tools/hymn_letter_v3_package_aac.py"}}}]},
        "qc": {"allOf": [{"$ref": "#/$defs/module"}, {"properties": {"path": {"const": "godo-hymns/tools/hymn_letter_v3_qc_aac.py"}}}]},
        "playlist_active_rows": {"allOf": [{"$ref": "#/$defs/module"}, {"properties": {"path": {"const": "godo-hymns/tools/hymn_letter_v3_playlist_active_rows.py"}}}]},
        "avfoundation_probe_source": {"allOf": [{"$ref": "#/$defs/module"}, {"properties": {"path": {"const": "godo-hymns/tools/hymn_letter_avfoundation_probe.m"}}}]}
      }
    },
    "supported_profiles": {
      "const": [
        "start-hybrid/v1",
        "playlist/v1",
        "testimony-static/v1",
        "hymn-lyrics/v1"
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_bundle_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "golden_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^[^\\\\]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
