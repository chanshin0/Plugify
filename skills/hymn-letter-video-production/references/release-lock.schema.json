{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugify.local/schemas/hymn-letter-release-lock.json",
  "title": "Office-native Hymn Letter release lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "created_at",
    "source_bundle_lock",
    "environment_lock",
    "golden_lock",
    "jobs",
    "renderer_modules",
    "supported_profiles",
    "notes",
    "source_bundle_lock_sha256",
    "environment_lock_sha256",
    "golden_lock_sha256"
  ],
  "properties": {
    "schema": {
      "const": "godowon.hymn-letter.v3-release-lock/1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "source_bundle_lock": {
      "type": "string",
      "pattern": "^[^\\\\]+\\.json$"
    },
    "environment_lock": {
      "type": "string",
      "pattern": "^[^\\\\]+\\.json$"
    },
    "golden_lock": {
      "type": "string",
      "pattern": "^[^\\\\]+\\.json$"
    },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[^\\\\]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "renderer_modules": {
      "type": "object"
    },
    "supported_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_bundle_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "environment_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "golden_lock_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
