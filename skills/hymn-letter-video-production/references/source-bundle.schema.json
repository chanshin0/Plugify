{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugify.local/schemas/hymn-letter-source-bundle.json",
  "title": "Office-native content-addressed Hymn Letter source bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "release_id",
    "storage_layout",
    "objects"
  ],
  "properties": {
    "schema": {
      "const": "godowon.hymn-letter.source-bundle/1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "storage_layout": {
      "const": "objects/sha256/<prefix>/<digest-rest>"
    },
    "objects": {
      "type": "object",
      "patternProperties": {
        "^sha256:[0-9a-f]{64}$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "size",
            "filenames",
            "roles"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "filenames": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              }
            },
            "roles": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
