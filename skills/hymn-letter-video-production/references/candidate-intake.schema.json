{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugify.local/schemas/hymn-letter-candidate-intake-v1.json",
  "title": "Godowon Hymn Letter candidate intake receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "series_name", "base_release", "episode", "inputs", "approvals", "probe", "catalog"],
  "properties": {
    "schema": {"const": "godowon.hymn-letter.episode-intake/1"},
    "status": {"const": "CANDIDATE_UNAPPROVED"},
    "series_name": {"const": "'고도원의 찬송편지'"},
    "base_release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_id", "release_lock_sha256"],
      "properties": {
        "release_id": {"const": "hymn-letter-caption-v4-interview-soft-20260826"},
        "release_lock_sha256": {"const": "24867e11a54c33f69005ed7b033f3996200597697fa99657bb4764ea9ddff7e6"}
      }
    },
    "episode": {"$ref": "#/$defs/episode"},
    "inputs": {"type": "object"},
    "approvals": {"type": "object"},
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ffprobe_sha256", "ffprobe_version", "audio", "captions"],
      "properties": {
        "ffprobe_sha256": {"$ref": "#/$defs/sha256"},
        "ffprobe_version": {"type": "string", "minLength": 1},
        "audio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["codec_name", "profile", "sample_rate", "channels", "duration_ms", "movie_timescale", "render_frame_count"],
          "properties": {
            "codec_name": {"type": "string", "minLength": 1},
            "profile": {"type": "string", "minLength": 1},
            "sample_rate": {"type": "integer", "minimum": 1},
            "channels": {"type": "integer", "minimum": 1},
            "duration_ms": {"type": "integer", "minimum": 1},
            "movie_timescale": {"type": ["integer", "null"], "minimum": 1},
            "render_frame_count": {"type": "integer", "minimum": 1}
          }
        },
        "captions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cue_count", "last_end_ms"],
          "properties": {
            "cue_count": {"type": "integer", "minimum": 1},
            "last_end_ms": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256", "track_sequence"],
      "properties": {
        "schema": {"const": "godowon.hymn-letter.track-catalog/1"},
        "sha256": {"const": "676407cca40e2fdbac024400dfbdf8c83867e6e33388dee9507c7c5a5bc7ff72"},
        "track_sequence": {"type": "integer", "minimum": 8, "maximum": 26}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "episode_id", "kind", "profile", "hymn_number", "title"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 7, "maximum": 26},
        "episode_id": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9][a-z0-9-]*$"},
        "kind": {"enum": ["testimony_intro", "hymn_lyrics"]},
        "profile": {"enum": ["testimony-static/v1", "hymn-lyrics/v1"]},
        "hymn_number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_id", "sha256", "size", "original_filename"],
      "properties": {
        "object_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1},
        "original_filename": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\\\u0000\\r\\n]+$"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"episode": {"properties": {"profile": {"const": "testimony-static/v1"}}, "required": ["profile"]}}, "required": ["episode"]},
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["approved_script", "narration_audio", "captions", "backplate", "thumbnail", "font", "narration_receipt", "speech_master_report"],
            "properties": {
              "approved_script": {"$ref": "#/$defs/input"},
              "narration_audio": {"$ref": "#/$defs/input"},
              "captions": {"$ref": "#/$defs/input"},
              "backplate": {"$ref": "#/$defs/input"},
              "thumbnail": {"$ref": "#/$defs/input"},
              "font": {"$ref": "#/$defs/input"},
              "narration_receipt": {"$ref": "#/$defs/input"},
              "speech_master_report": {"$ref": "#/$defs/input"}
            }
          },
          "probe": {
            "properties": {
              "audio": {
                "properties": {
                  "codec_name": {"const": "aac"},
                  "sample_rate": {"const": 48000},
                  "channels": {"const": 2},
                  "movie_timescale": {"type": "integer", "minimum": 1}
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"episode": {"properties": {"profile": {"const": "hymn-lyrics/v1"}}, "required": ["profile"]}}, "required": ["episode"]},
      "then": {
        "properties": {
          "inputs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["audio", "captions", "backplate", "thumbnail", "font"],
            "properties": {
              "audio": {"$ref": "#/$defs/input"},
              "captions": {"$ref": "#/$defs/input"},
              "backplate": {"$ref": "#/$defs/input"},
              "thumbnail": {"$ref": "#/$defs/input"},
              "font": {"$ref": "#/$defs/input"}
            }
          },
          "approvals": {
            "$comment": "catalog_audio_sha_match is a producer assertion only; validate-candidate independently binds the immutable catalog SHA and exact audio/caption object IDs, PCM anchor, metadata, and frame count.",
            "type": "object",
            "additionalProperties": false,
            "required": ["catalog_audio_sha_match"],
            "properties": {"catalog_audio_sha_match": {"const": true}}
          },
          "probe": {
            "properties": {
              "audio": {
                "properties": {
                  "codec_name": {"const": "mp3"},
                  "sample_rate": {"const": 44100},
                  "channels": {"const": 2},
                  "movie_timescale": {"type": "null"}
                }
              }
            }
          }
        }
      }
    }
  ]
}
