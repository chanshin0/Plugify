+"""가격 정책의 순서와 반올림 경계를 고정하는 회귀 테스트."""
+
+from decimal import Decimal
+import unittest
+from ledger import total
+
+
+class PolicyRegressionTests(unittest.TestCase):
+    def test_fixed_before_tax(self):
+        self.assertEqual(total({"items": [{"qty": 1, "unit_price": 100}],
+                                "coupon": {"type": "fixed", "value": 10},
+                                "tax_rate_pct": 8}), Decimal("97.20"))
+
+    def test_no_intermediate_rounding(self):
+        self.assertEqual(total({"items": [{"qty": 3, "unit_price": 1.005}]}), Decimal("3.02"))
+        self.assertEqual(total({"items": [{"qty": 1, "unit_price": 10.005}],
+                                "tax_rate_pct": 10}), Decimal("11.01"))
+
+    def test_half_up(self):
+        self.assertEqual(total({"items": [{"qty": 1, "unit_price": 2.675}]}), Decimal("2.68"))
+        self.assertEqual(total({"items": [{"qty": 1, "unit_price": 2.665}]}), Decimal("2.67"))
+
+    def test_clamp_and_validation(self):
+        self.assertEqual(total({"items": [{"qty": 1, "unit_price": 10}],
+                                "coupon": {"type": "fixed", "value": 20},
+                                "tax_rate_pct": 10}), Decimal("0.00"))
+        with self.assertRaises(ValueError):
+            total({"items": [{"qty": 0, "unit_price": 100}]})
